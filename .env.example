# Copy these names into your operating-system environment. Never commit real values.
RAG_API_KEY=replace-me
# Optional when the reranker uses a different credential.
RAG_RERANK_API_KEY=replace-me
# Absolute path to your private config copied from config/chilon-recall.example.json.
RAG_MANAGER_CONFIG=replace-with-an-absolute-path
# Optional: absolute path to the Python executable that has chilon-recall-engine installed.
CHILON_RECALL_PYTHON=python

